generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  avatar       String?
  slackWebhook String?
  slackChannel String?
  slackToken   String?
  createdAt    DateTime   @default(now())
  emails       EmailJob[]
}

model SenderAccount {
  id          String     @id @default(uuid())
  email       String     @unique
  name        String
  host        String
  port        Int
  user        String
  pass        String
  hourlyLimit Int        @default(200)
  createdAt   DateTime   @default(now())
  emails      EmailJob[]
}

model EmailJob {
  id           String    @id @default(uuid())
  userId       String?
  senderId     String?
  recipient    String
  subject      String
  body         String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String    @default("PENDING") // PENDING, QUEUED, RATE_LIMITED, SENT, FAILED, CANCELLED
  bullJobId    String?   @unique
  attempts     Int       @default(0)
  errorMessage String?
  etherealUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?          @relation(fields: [userId], references: [id])
  sender       SenderAccount? @relation(fields: [senderId], references: [id])

  @@index([recipient])
  @@index([scheduledAt])
  @@index([status])
}
